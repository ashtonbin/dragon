# Auto detect text files and perform LF normalization
* text=auto
*.cs text eol=lf
*.shader text eol=lf
*.json text eol=lf
*.md text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.png binary
*.jpg binary
*.exr binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.asset -text
